# Collector image boundary: deny by default and admit only declared build inputs.
**
!collector/
collector/**
!collector/Dockerfile
!collector/Dockerfile.dockerignore
!collector/CMakeLists.txt
!collector/config.example.ini
!collector/cmake/
collector/cmake/**
!collector/cmake/ctp_sdk.cmake
!collector/include/
collector/include/**
!collector/include/client_support.hpp
!collector/third_party/
collector/third_party/**
!collector/third_party/ctp/
collector/third_party/ctp/**
!collector/third_party/ctp/v6.7.13_20260225/
collector/third_party/ctp/v6.7.13_20260225/**
!collector/third_party/ctp/v6.7.13_20260225/MANIFEST.txt
!collector/third_party/ctp/v6.7.13_20260225/linux64/
collector/third_party/ctp/v6.7.13_20260225/linux64/**
!collector/third_party/ctp/v6.7.13_20260225/linux64/mdapi/
collector/third_party/ctp/v6.7.13_20260225/linux64/mdapi/**
!collector/third_party/ctp/v6.7.13_20260225/linux64/mdapi/ThostFtdcMdApi.h
!collector/third_party/ctp/v6.7.13_20260225/linux64/mdapi/ThostFtdcUserApiDataType.h
!collector/third_party/ctp/v6.7.13_20260225/linux64/mdapi/ThostFtdcUserApiStruct.h
!collector/third_party/ctp/v6.7.13_20260225/linux64/mdapi/thostmduserapi_se.so
!collector/src/
collector/src/**
!collector/src/config.hpp
!collector/src/health.hpp
!collector/src/main.cpp
!collector/src/market.hpp
!collector/src/runtime.cpp
!collector/src/runtime.hpp
!collector/src/session.cpp
!collector/src/session.hpp
!collector/src/storage.cpp
!collector/src/storage.hpp
!collector/tests/
collector/tests/**
!collector/tests/config_test.cpp
!collector/tests/fake_api.hpp
!collector/tests/fake_sdk.cpp
