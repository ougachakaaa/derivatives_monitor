# Allow only the source inputs needed by the Collector build.
**
!collector/
!collector/Dockerfile
!collector/CMakeLists.txt
!collector/config.example.ini
!collector/src/
!collector/src/**
!collector/tests/
!collector/tests/*.cpp
!collector/tests/*.hpp
!collector/scripts/
!collector/scripts/verify.sh
!collector/scripts/healthcheck.sh
!experiments/
!experiments/ctp/
!experiments/ctp/common/
!experiments/ctp/common/*.hpp
!experiments/ctp/common/*.cmake
!experiments/ctp/sdk/
!experiments/ctp/sdk/v6.7.13_20260225/
!experiments/ctp/sdk/v6.7.13_20260225/linux64/
!experiments/ctp/sdk/v6.7.13_20260225/linux64/mdapi/
!experiments/ctp/sdk/v6.7.13_20260225/linux64/mdapi/*.h
!experiments/ctp/sdk/v6.7.13_20260225/linux64/mdapi/thostmduserapi_se.so
!query/
!query/Dockerfile
!query/pyproject.toml
!query/poetry.lock
!query/app.py
!query/storage.py
!query/tests/
!query/tests/test_api.py
!dashboard/
!dashboard/Dockerfile
!dashboard/package.json
!dashboard/package-lock.json
!dashboard/index.html
!dashboard/vite.config.js
!dashboard/nginx.conf
!dashboard/src/
!dashboard/src/**
!dashboard/tests/
!dashboard/tests/**
# Keep local secrets/runtime outputs excluded even if placed inside source trees.
**/.env
**/.env.*
**/config.ini
**/credentials.*
**/secrets.*
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.sqlite*
**/*.db
**/*.log
