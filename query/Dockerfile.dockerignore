# Query image boundary: deny by default and admit only declared build inputs.
**
!query/
query/**
!query/Dockerfile
!query/Dockerfile.dockerignore
!query/pyproject.toml
!query/poetry.lock
!query/app.py
!query/storage.py
!query/contract_coverage.py
!query/market_calendar.py
!query/market_state.py
!query/analytics.py
!query/skew_service.py
!query/skew_references.py
!query/feature_service.py
!query/calendars/
query/calendars/**
!query/calendars/2026.json
!query/tests/
query/tests/**
!query/tests/test_analytics.py
!query/tests/test_api.py
!query/tests/test_calendar.py
!query/tests/test_coverage.py
!query/tests/test_market_state.py
!query/tests/test_sessions_api.py
!query/tests/test_skew_api.py
!query/tests/test_feature_service.py
!query/tests/test_features_api.py
!harness/
harness/**
!harness/fixtures/
harness/fixtures/**
!harness/fixtures/analytics-skew-v1.json

# Defense in depth for secrets and runtime state.
**/.env
**/.env.*
**/config.ini
**/credentials.*
**/secrets.*
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.sqlite*
**/*.db
**/*.log
