# Query image boundary: deny by default and admit only declared build inputs.
**
!query/
query/**
!query/Dockerfile
!query/Dockerfile.dockerignore
!query/pyproject.toml
!query/poetry.lock
!query/__init__.py
!query/app.py
!query/errors.py
!query/indicator_service.py
!query/tests/
query/tests/**
!query/tests/__init__.py
!query/tests/test_api.py
!query/tests/test_coverage_api.py
!query/tests/test_sessions_api.py
!query/tests/test_skew_api.py
!query/tests/test_indicator_service.py
!query/tests/test_indicators_api.py

!data_provider/
data_provider/**
!data_provider/__init__.py
!data_provider/errors.py
!data_provider/storage.py
!data_provider/contract_coverage.py
!data_provider/market_calendar.py
!data_provider/market_frame.py
!data_provider/calendars/
data_provider/calendars/**
!data_provider/calendars/2026.json
!data_provider/tests/
data_provider/tests/**
!data_provider/tests/__init__.py
!data_provider/tests/test_calendar.py
!data_provider/tests/test_storage.py
!data_provider/tests/test_coverage.py
!data_provider/tests/test_market_frame.py

!analytics/
analytics/**
!analytics/__init__.py
!analytics/errors.py
!analytics/skew.py
!analytics/skew_service.py
!analytics/skew_references.py
!analytics/contracts/
analytics/contracts/**
!analytics/contracts/analytics-skew-v1.json
!analytics/tests/
analytics/tests/**
!analytics/tests/__init__.py
!analytics/tests/test_skew.py
!analytics/tests/test_skew_service.py
!analytics/tests/analytics_contract.py
!analytics/tests/test_analytics_contract.py
!analytics/tests/fixtures/
analytics/tests/fixtures/**
!analytics/tests/fixtures/analytics-skew-v1.json

# Defense in depth for secrets and runtime state.
**/.env
**/.env.*
**/config.ini
**/credentials.*
**/secrets.*
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.sqlite*
**/*.db
**/*.log
