# Query image boundary: deny by default and admit only declared build inputs.
**
!query/
query/**
!query/Dockerfile
!query/Dockerfile.dockerignore
!query/pyproject.toml
!query/poetry.lock
!query/__init__.py
!query/app.py
!query/storage.py
!query/contract_coverage.py
!query/market_frame.py
!query/analytics.py
!query/skew_service.py
!query/skew_references.py
!query/indicator_service.py
!query/tests/
query/tests/**
!query/tests/__init__.py
!query/tests/test_analytics.py
!query/tests/test_api.py
!query/tests/test_coverage.py
!query/tests/test_market_frame.py
!query/tests/test_sessions_api.py
!query/tests/test_skew_api.py
!query/tests/test_indicator_service.py
!query/tests/test_indicators_api.py
!query/tests/analytics_contract.py
!query/tests/analytics_oracle.py
!query/tests/test_analytics_contract.py
!query/tests/fixtures/
query/tests/fixtures/**
!query/tests/fixtures/analytics-skew-v1.json

!data_provider/
data_provider/**
!data_provider/__init__.py
!data_provider/market_calendar.py
!data_provider/calendars/
data_provider/calendars/**
!data_provider/calendars/2026.json
!data_provider/tests/
data_provider/tests/**
!data_provider/tests/__init__.py
!data_provider/tests/test_calendar.py

# Defense in depth for secrets and runtime state.
**/.env
**/.env.*
**/config.ini
**/credentials.*
**/secrets.*
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.sqlite*
**/*.db
**/*.log
